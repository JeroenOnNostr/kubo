<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Kubo logo: 4 colored rounded squares from public/logo-color.svg.
      Original viewBox is 70x70. Scaled to 72dp and centered in the
      108dp adaptive-icon canvas so the logo sits inside the safe zone.
      translate = (108 - 72) / 2 = 18 ; scale = 72 / 70 ≈ 1.0286
    -->

    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="1.02857"
        android:scaleY="1.02857">

        <!-- Orange square — top-left -->
        <path
            android:fillColor="#F97316"
            android:pathData="M9,0 L25,0 A9,9 0 0,1 34,9 L34,25 A9,9 0 0,1 25,34 L9,34 A9,9 0 0,1 0,25 L0,9 A9,9 0 0,1 9,0 Z" />

        <!-- Cyan square — top-right -->
        <path
            android:fillColor="#06B6D4"
            android:pathData="M45,0 L61,0 A9,9 0 0,1 70,9 L70,25 A9,9 0 0,1 61,34 L45,34 A9,9 0 0,1 36,25 L36,9 A9,9 0 0,1 45,0 Z" />

        <!-- Indigo square — bottom-left -->
        <path
            android:fillColor="#6366F1"
            android:pathData="M9,36 L25,36 A9,9 0 0,1 34,45 L34,61 A9,9 0 0,1 25,70 L9,70 A9,9 0 0,1 0,61 L0,45 A9,9 0 0,1 9,36 Z" />

        <!-- Green square — bottom-right -->
        <path
            android:fillColor="#22C55E"
            android:pathData="M45,36 L61,36 A9,9 0 0,1 70,45 L70,61 A9,9 0 0,1 61,70 L45,70 A9,9 0 0,1 36,61 L36,45 A9,9 0 0,1 45,36 Z" />

    </group>

</vector>
