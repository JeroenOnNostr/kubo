<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="1200"
    android:viewportHeight="1200">

    <!--
      Kubo splash icon — 4 colored rounded squares, sourced from public/logo-color.svg.

      Quadrant → color (decoded from the source SVG's rotate(-180 cx cy) transforms,
      which rotate each rect around its bottom-right corner so it renders into the
      quadrant toward the origin):
        top-left     orange  #F97316
        top-right    cyan    #06B6D4
        bottom-left  indigo  #6366F1
        bottom-right green   #22C55E

      Source SVG viewBox is 70×70 — four 34×34 squares with rx=9, separated by a 2-unit gap.
      Android 12 splash spec: icon canvas 240dp / viewport 1200, visible inside a circle
      of 160dp (≈800 viewport units). Targeting 600 viewport units for the logo leaves
      breathing room inside the circular safe zone.
        scale = 600 / 70 ≈ 8.571
        translate = (1200 − 600) / 2 = 300

      NOTE: scripts/generate-icons.mjs does NOT regenerate this file — it's hand-edited.
    -->

    <group
        android:translateX="300"
        android:translateY="300"
        android:scaleX="8.571"
        android:scaleY="8.571">

        <!-- top-left: orange -->
        <group android:translateX="0" android:translateY="0">
            <path
                android:fillColor="#F97316"
                android:pathData="M9,0 H25 A9,9 0 0 1 34,9 V25 A9,9 0 0 1 25,34 H9 A9,9 0 0 1 0,25 V9 A9,9 0 0 1 9,0 Z" />
        </group>

        <!-- top-right: cyan -->
        <group android:translateX="36" android:translateY="0">
            <path
                android:fillColor="#06B6D4"
                android:pathData="M9,0 H25 A9,9 0 0 1 34,9 V25 A9,9 0 0 1 25,34 H9 A9,9 0 0 1 0,25 V9 A9,9 0 0 1 9,0 Z" />
        </group>

        <!-- bottom-left: indigo -->
        <group android:translateX="0" android:translateY="36">
            <path
                android:fillColor="#6366F1"
                android:pathData="M9,0 H25 A9,9 0 0 1 34,9 V25 A9,9 0 0 1 25,34 H9 A9,9 0 0 1 0,25 V9 A9,9 0 0 1 9,0 Z" />
        </group>

        <!-- bottom-right: green -->
        <group android:translateX="36" android:translateY="36">
            <path
                android:fillColor="#22C55E"
                android:pathData="M9,0 H25 A9,9 0 0 1 34,9 V25 A9,9 0 0 1 25,34 H9 A9,9 0 0 1 0,25 V9 A9,9 0 0 1 9,0 Z" />
        </group>

    </group>

</vector>
